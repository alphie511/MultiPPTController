<Application x:Class="MultiPPTController.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             StartupUri="MainWindow.xaml"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
                <ResourceDictionary Source="Themes/Controls.xaml" />
                <ResourceDictionary Source="Themes/Dark.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <FontFamily x:Key="AppFont">Segoe UI Variable Display, Segoe UI, Microsoft YaHei UI</FontFamily>
            <BitmapImage x:Key="LogoImage" UriSource="pack://application:,,,/Assets/logo.png" />
            <BitmapImage x:Key="MonitorIcon" UriSource="pack://application:,,,/Assets/monitor.png" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
