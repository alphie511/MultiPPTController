<ui:FluentWindow x:Class="MultiPPTController.AboutWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="关于 MultiPPT"
                 Width="720"
                 Height="480"
                 MinWidth="640"
                 MinHeight="420"
                 ResizeMode="NoResize"
                 WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="None"
                 Background="Transparent"
                 FontFamily="{StaticResource AppFont}">
    <Grid>
        <Image Source="{DynamicResource WindowBackground}" Stretch="UniformToFill" />
        <ui:TitleBar Title=""
                     Height="32"
                     ShowMaximize="False"
                     ShowMinimize="False"
                     Foreground="{DynamicResource InkBrush}"
                     ButtonsForeground="{DynamicResource CaptionButtonBrush}"
                     ButtonsBackground="Transparent">
            <ui:TitleBar.Header>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Top" Margin="16,2,0,0">
                    <Image Source="{StaticResource LogoImage}"
                           Width="26"
                           Height="26"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           Margin="0,0,8,0" />
                    <TextBlock Text="关于 MultiPPT"
                               FontSize="13"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource InkBrush}" />
                </StackPanel>
            </ui:TitleBar.Header>
        </ui:TitleBar>

        <Border Margin="56,56,56,36"
                CornerRadius="22"
                Padding="1">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                    <GradientStop Color="#882F86FF" Offset="0" />
                    <GradientStop Color="#88C13DFF" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <Border CornerRadius="21"
                    Background="{DynamicResource CardFillBrush}"
                    Padding="36,28">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Image Source="{StaticResource LogoImage}"
                               Width="92"
                               Height="92"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                        <TextBlock Margin="0,16,0,0"
                                   FontSize="34"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center">
                            <TextBlock.Foreground>
                                <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                    <GradientStop Color="#5AB4FF" Offset="0" />
                                    <GradientStop Color="#C13DFF" Offset="1" />
                                </LinearGradientBrush>
                            </TextBlock.Foreground>
                            MultiPPT
                        </TextBlock>
                        <Border HorizontalAlignment="Center"
                                Margin="0,10,0,12"
                                Padding="12,3"
                                CornerRadius="11"
                                BorderThickness="1"
                                BorderBrush="{DynamicResource AccentCyanBrush}">
                            <TextBlock Text="v1.0.0"
                                       FontSize="12"
                                       Foreground="{DynamicResource AccentCyanBrush}" />
                        </Border>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Border Width="36" Height="1" Background="{DynamicResource GhostBorderBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="  多屏同步放映控制端  "
                                       Foreground="{DynamicResource InkBrush}"
                                       FontSize="14" />
                            <Border Width="36" Height="1" Background="{DynamicResource GhostBorderBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="© 2026 MultiPPT Team. All rights reserved."
                                   Foreground="{DynamicResource HintBrush}"
                                   FontSize="12"
                                   Margin="0,16,0,0"
                                   HorizontalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Grid.Row="1"
                                Orientation="Horizontal"
                                HorizontalAlignment="Center">
                        <Button Content="检查更新"
                                Style="{StaticResource GhostPillButton}"
                                Margin="0,0,12,0"
                                Click="OnCheckUpdateClick" />
                        <Button Content="确定"
                                Style="{StaticResource GradientPillButton}"
                                MinWidth="112"
                                Click="OnCloseClick" />
                    </StackPanel>
                </Grid>
            </Border>
        </Border>
    </Grid>
</ui:FluentWindow>
