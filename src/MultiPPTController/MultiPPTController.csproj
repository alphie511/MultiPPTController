<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <RootNamespace>MultiPPTController</RootNamespace>
    <AssemblyName>MultiPPTController</AssemblyName>
    <LangVersion>latest</LangVersion>
    <ApplicationTitle>MultiPPT 多屏同步放映</ApplicationTitle>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets\**\*.*" />
    <None Include="PlayerHost\**\*.*" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(NuGetPackageRoot)docnet.core\2.6.0\runtimes\win-x64\native\pdfium.dll"
          CopyToOutputDirectory="PreserveNewest"
          Link="pdfium.dll"
          Visible="false" />
  </ItemGroup>
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Docnet.Core" Version="2.6.0" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2849.39" />
    <PackageReference Include="WPF-UI" Version="4.0.3" />
  </ItemGroup>
</Project>
