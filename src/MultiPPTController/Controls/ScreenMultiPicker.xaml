<UserControl x:Class="MultiPPTController.Controls.ScreenMultiPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinHeight="36"
             SnapsToDevicePixels="True">
    <Grid>
        <ToggleButton x:Name="Toggle"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      HorizontalContentAlignment="Stretch"
                      Focusable="False"
                      OverridesDefaultStyle="True"
                      ClickMode="Press">
            <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Chrome"
                            CornerRadius="12"
                            Padding="1"
                            SnapsToDevicePixels="True">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                <GradientStop Color="#664AA6FF" Offset="0" />
                                <GradientStop Color="#66C13DFF" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border CornerRadius="11"
                                Background="{DynamicResource ComboPopupBrush}"
                                Padding="12,0,10,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="22" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Margin="0,0,8,0"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource InkBrush}"
                                           Text="{Binding AssignmentSummary}" />
                                <Path x:Name="Arrow"
                                      Grid.Column="1"
                                      Width="10"
                                      Height="6"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Data="M0,0 L10,0 L5,6 Z"
                                      Fill="{DynamicResource MutedBrush}"
                                      Stretch="Fill" />
                            </Grid>
                        </Border>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Arrow" Property="Fill" Value="{DynamicResource InkBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Arrow" Property="RenderTransform">
                                <Setter.Value>
                                    <RotateTransform Angle="180" CenterX="5" CenterY="3" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </ToggleButton.Template>
        </ToggleButton>
        <Popup AllowsTransparency="True"
               Focusable="False"
               IsOpen="{Binding IsChecked, ElementName=Toggle, Mode=TwoWay}"
               Placement="Bottom"
               PlacementTarget="{Binding ElementName=Toggle}"
               PopupAnimation="Fade"
               StaysOpen="False"
               VerticalOffset="6">
            <Border MinWidth="{Binding ActualWidth, ElementName=Toggle}"
                    MaxHeight="280"
                    CornerRadius="12"
                    Padding="1">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#664AA6FF" Offset="0" />
                        <GradientStop Color="#66C13DFF" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
                <Border.Effect>
                    <DropShadowEffect BlurRadius="16" Opacity="0.35" ShadowDepth="4" Color="#000000" />
                </Border.Effect>
                <Border Background="{DynamicResource ComboPopupBrush}" CornerRadius="11">
                    <ScrollViewer Margin="2,6" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding ScreenOptions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Margin="8,4"
                                              Padding="6,4"
                                              VerticalContentAlignment="Center"
                                              Content="{Binding Label}"
                                              Foreground="{DynamicResource InkBrush}"
                                              IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                              IsEnabled="{Binding IsAvailable}">
                                        <CheckBox.Style>
                                            <Style TargetType="CheckBox">
                                                <Style.Triggers>
                                                    <Trigger Property="IsEnabled" Value="False">
                                                        <Setter Property="Foreground" Value="{DynamicResource HintBrush}" />
                                                        <Setter Property="Opacity" Value="0.45" />
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </CheckBox.Style>
                                    </CheckBox>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
            </Border>
        </Popup>
    </Grid>
</UserControl>
