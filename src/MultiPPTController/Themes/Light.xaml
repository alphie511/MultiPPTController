<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ImageSource x:Key="WindowBackground">pack://application:,,,/Assets/bg-light.png</ImageSource>
    <ImageSource x:Key="PptIcon">pack://application:,,,/Assets/ppt-file-light.png</ImageSource>
    <SolidColorBrush x:Key="InkBrush" Color="#1B2436" />
    <SolidColorBrush x:Key="CaptionButtonBrush" Color="#1B2436" />
